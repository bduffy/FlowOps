# FlowOps environment. Copy to .env (gitignored). Dev mode needs no cloud credentials.

# Execution profile: dev | cloud
#   dev   -> DummyActuator, advisory budget, zero cloud creds (default)
#   cloud -> RealActuator (not implemented yet)
FLOWOPS_PROFILE=dev

# Default region for sandbox provisioning (cloud profile).
FLOWOPS_REGION=us-east-1

# --- cloud profile only (do NOT set in dev) -----------------------------------
# Provisioning identity is assumed via OIDC at runtime — NO static keys here (SR4).
# DATABASE_URL=postgresql://flowops:flowops@db:5432/flowops
